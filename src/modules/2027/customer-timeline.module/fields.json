          ],
          [
            "128",
            "128px"
          ]
        ],
        "default": "96"
      },
      {
        "name": "spacing_bottom",
        "label": "Space below",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "0",
            "None"
          ],
          [
            "32",
            "32px"
          ],
          [
            "48",
            "48px"
          ],
          [
            "64",
            "64px"
          ],
          [
            "80",
            "80px"
          ],
          [
            "96",
            "96px"
          ],
          [
            "112",
            "112px"
          ],
          [
            "120",
            "120px"
          ],
          [
            "128",
            "128px"
          ]
        ],
        "default": "128"
      }
    ]
  }
]