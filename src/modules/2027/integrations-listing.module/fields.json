[
  {
    "name": "mode",
    "label": "Listing",
    "type": "choice",
    "display": "radio",
    "choices": [
      [
        "integrations",
        "Integrations (one category filter)"
      ],
      [
        "partners",
        "Partners (programs, categories, capabilities)"
      ]
    ],
    "default": "integrations"
  },
  {
    "name": "hubdb_table",
