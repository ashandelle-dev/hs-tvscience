[
  {
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "children": [
      {
        "name": "value",
        "label": "Text",
        "type": "text",
        "allow_new_line": false,
        "default": "TV that drives outcomes"
      },
      {
        "name": "header_tag",
        "label": "Tag",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "h1",
            "H1"
          ],
          [
            "h2",
            "H2"
          ],
          [
            "p",
            "Paragraph"
          ]
        ],
        "default": "h1"
      }
    ]
  },
  {
    "name": "body_copy",
    "label": "Body copy",
    "type": "richtext",
    "enabled_features": [
      "bold",
      "italic",
      "link",
      "nonbreaking_space"
    ],
    "default": "<p>Premium inventory, AI-powered optimization. Radical transparency.<br>Drive any outcome: traffic, installs, sales, and more.</p>"
  },
  {
    "name": "cta",
    "label": "Button",
    "type": "group",
    "children": [
      {
        "name": "text",
        "label": "Text",
        "type": "text",
        "allow_new_line": false,
        "default": "Request a Demo"
      },
      {
        "name": "link",
        "label": "Link",
        "type": "link",
        "supported_types": [
          "EXTERNAL",
          "CONTENT",
          "FILE",
          "EMAIL_ADDRESS",
          "BLOG"
        ],
        "default": {
          "url": {
            "content_id": null,
            "type": "EXTERNAL",
            "href": "https://www.tvscientific.com/contact"
          },
          "open_in_new_tab": false,
          "no_follow": false
        }
      }
    ]
  },
  {
    "name": "center_card",
    "label": "Center image",
    "type": "group",
    "children": [
      {
        "name": "image",
        "label": "Image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "show_loading": true,
        "help_text": "Cropped to 16:9.",
        "default": {
          "src": "https://8975772.fs1.hubspotusercontent-na1.net/hubfs/8975772/2027-reskin/home/hero-center-2.jpg",
          "alt": "Two friends laughing and taking a selfie on a green couch",
          "width": 1376,
          "height": 774,
          "size_type": "exact",
          "loading": "lazy"
        }
      },
      {
        "name": "lottie",
        "label": "Lottie JSON URL (optional, plays over the image and replaces the badge)",
        "type": "text",
        "inline_help_text": "The animation is sized to the card (transparent background). The badge title below is still used as its screen-reader label.",
        "default": "https://8975772.fs1.hubspotusercontent-na1.net/hubfs/8975772/2027-reskin/lottie/hero-center-v2.json"
      },
      {
        "name": "lottie_hold_frame",
        "label": "Lottie hold frame (optional)",
        "type": "number",
        "display": "text",
        "inline_help_text": "Frame shown until the animation starts, for animations whose first frame is empty. It plays on from this frame. Reduced-motion visitors stay on it.",
        "default": null
      },
      {
        "name": "lottie_placement",
        "label": "Lottie placement",
        "type": "choice",
        "display": "select",
        "choices": [["card", "On the card"], ["up_left", "Up and left of the card (badge overhangs the top)"]],
        "default": "card"
      },
      {
        "name": "badge",
        "label": "Overlay badge",
        "type": "group",
        "expanded": false,
        "help_text": "Leave the title empty for no badge.",
