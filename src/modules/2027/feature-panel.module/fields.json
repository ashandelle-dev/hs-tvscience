[
  {
    "name": "layout",
    "label": "Layout",
    "type": "choice",
    "display": "radio",
    "choices": [
      [
        "panel",
        "Image panel beside the features (homepage)"
      ],
      [
        "grid",
        "Heading on top, features in columns"
      ],
      [
        "diagram",
        "Dark diagram: three connected columns (Patents Brain Trust)"
      ]
    ],
    "default": "panel"
  },
  {
    "name": "diagram_pill",
