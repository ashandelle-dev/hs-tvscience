[
  {
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "tab": "CONTENT",
    "children": [
      {
        "name": "value",
        "label": "Heading content",
        "type": "text",
        "allow_new_line": true,
        "default": "Get the latest CTV news and stay up-to-date on stats and trends!"
      },
      {
        "name": "header_tag",
        "label": "Heading level",
        "type": "choice",
        "display": "select",
        "choices": [["h1", "H1"], ["h2", "H2"], ["h3", "H3"], ["h4", "H4"], ["h5", "H5"], ["h6", "H6"], ["p", "P"]],
        "default": "h2"
      },
      {
        "name": "heading_size",
        "label": "Heading size",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 36
      },
      {
        "name": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 28
      },
      {
        "name": "font_weight",
        "label": "Font weight",
        "type": "choice",
        "display": "select",
        "choices": [["normal", "Normal"], ["semibold", "Semibold"], ["bold", "Bold"]],
        "default": "bold"
      }
    ]
  },

  {
    "name": "form",
    "label": "Form",
    "type": "form",
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks for submitting the form.",
      "gotowebinar_webinar_key": null
    }
  },

  {
    "name": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "background_color",
        "label": "Section background color",
        "type": "color",
        "default": { "color": null, "opacity": 100 }
      },
      {
        "name": "background_image",
        "label": "Section background image",
        "type": "image",
        "default": { "size_type": "auto", "src": "", "alt": "", "loading": "lazy" }
      },
      {
        "name": "text_color",
        "label": "Heading text color",
        "type": "color",
        "default": { "color": null, "opacity": 100 }
      },
      {
        "name": "padding",
        "label": "Section padding",
        "type": "spacing",
        "default": {
          "padding": {
            "top":    { "value": 80, "units": "px" },
            "bottom": { "value": 80, "units": "px" }
          }
        }
      },
      {
        "name": "container_max_width",
        "label": "Container max width",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "inline_help_text": "Override the default 1072px container width. Set to 0 to use the theme default.",
        "default": 1200
      },
      {
        "name": "card_background_color",
        "label": "Card background color",
        "type": "color",
        "default": { "color": "#f9fafc", "opacity": 100 }
      },
      {
        "name": "card_border_color",
        "label": "Card border color",
        "type": "color",
        "inline_help_text": "Leave empty for no border.",
        "default": { "color": "#d9e2eb", "opacity": 100 }
      },
      {
        "name": "card_border_radius",
        "label": "Card border radius",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "max": 48,
        "step": 1,
        "default": 16
      },
      {
        "name": "card_inner_padding",
        "label": "Card inner padding",
        "type": "spacing",
        "default": {
          "padding": {
            "top":    { "value": 56, "units": "px" },
            "bottom": { "value": 56, "units": "px" },
            "left":   { "value": 80, "units": "px" },
            "right":  { "value": 80, "units": "px" }
          }
        }
      }
    ]
  }
]
