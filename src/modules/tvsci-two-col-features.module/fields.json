[
  {
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "tab": "CONTENT",
    "children": [
      {
        "name": "value",
        "label": "Heading content",
        "type": "text",
        "allow_new_line": false,
        "default": "The tvScientific difference"
      },
      {
        "name": "header_tag",
        "label": "Heading level",
        "type": "choice",
        "required": true,
        "display": "select",
        "choices": [
          ["h1", "H1"], ["h2", "H2"], ["h3", "H3"], ["h4", "H4"], ["h5", "H5"], ["h6", "H6"], ["p", "P"]
        ],
        "default": "h2"
      },
      {
        "name": "heading_size",
        "label": "Heading Size",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 32
      },
      {
        "name": "heading_size_mobile",
        "label": "Heading Size Mobile",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 28
      },
      {
        "name": "font_weight",
        "label": "Font Weight",
        "type": "choice",
        "display": "select",
        "choices": [["normal", "Normal"], ["semibold", "Semibold"], ["bold", "Bold"]],
        "default": "bold"
      }
    ]
  },

  {
    "name": "subheading",
    "label": "Subheading",
    "type": "richtext",
    "default": "<p>The most effective performance CTV platform purpose built to deliver outcomes.</p>"
  },

  {
    "name": "left_image",
    "label": "Left side image (dashboard / product screenshot)",
    "type": "image",
    "responsive": true,
    "resizable": true,
    "inline_help_text": "Composited dashboard screenshot. Default points to the production HubFS asset.",
    "default": {
      "size_type": "auto",
      "src": "https://tvscientific.com/hubfs/product%20dashboards.png",
      "alt": "tvScientific product dashboards",
      "loading": "lazy",
      "width": 0,
      "height": 0
    }
  },
  {
    "name": "image_cover",
    "label": "Cover image",
    "type": "boolean",
    "display": "toggle",
    "default": true,
    "inline_help_text": "On crops the image to fill the column. Off keeps its natural height."
  },
  {
    "name": "image_align",
    "label": "Image alignment",
    "type": "choice",
    "display": "select",
    "choices": [
      ["start", "Top"],
      ["center", "Center"],
      ["end", "Bottom"]
    ],
    "default": "center",
    "visibility": {
      "controlling_field": "image_cover",
      "controlling_value_regex": "false",
      "operator": "EQUAL"
    },
    "inline_help_text": "Vertical position of the image when cover is off."
  },

  {
    "name": "features",
    "label": "Features",
    "type": "group",
    "tab": "CONTENT",
    "occurrence": {
      "min": 1,
      "max": 8,
      "sorting_label_field": "heading_value",
      "default": 4
    },
    "children": [
      {
        "name": "icon",
        "label": "Icon",
        "type": "image",
        "responsive": false,
        "resizable": true,
        "default": {
          "size_type": "exact",
          "src": "",
          "alt": "",
          "loading": "lazy",
          "width": 29,
          "height": 29
        }
      },
      {
        "name": "heading_value",
        "label": "Feature heading",
        "type": "text",
        "allow_new_line": false,
        "default": "Feature heading"
      },
      {
        "name": "heading_size",
        "label": "Heading size",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "inline_help_text": "Set to 0 to use the default (22px).",
        "default": 22
      },
      {
        "name": "line_height",
        "label": "Line height",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "inline_help_text": "Set to 0 to use the default.",
        "default": 0
      },
      {
        "name": "letter_spacing",
        "label": "Letter spacing",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Use a negative value to tighten tracking. 0 matches Figma’s 0%.",
        "default": 0
      },
      {
        "name": "font_weight",
        "label": "Font weight",
        "type": "choice",
        "display": "select",
        "choices": [
          ["medium", "Medium"],
          ["normal", "Normal"],
          ["semibold", "Semibold"],
          ["bold", "Bold"]
        ],
        "default": "medium"
      },
      {
        "name": "body_copy",
        "label": "Feature description",
        "type": "richtext",
        "default": "<p>Short description of this feature.</p>"
      },
      {
        "name": "column_width",
        "label": "Feature width",
        "type": "choice",
        "display": "select",
        "choices": [
          ["6", "6 columns"],
          ["12", "12 columns"]
        ],
        "default": "6"
      },
      {
        "name": "cta",
        "label": "CTA",
        "type": "group",
        "children": [
          {
            "name": "show",
            "label": "Show button",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "text",
            "label": "Button text",
            "type": "text",
            "default": "Learn more",
            "visibility": {
              "controlling_field": "features.cta.show",
              "controlling_value_regex": "true",
              "operator": "EQUAL"
            }
          },
          {
            "name": "link",
            "label": "Button link",
            "type": "link",
            "supported_types": ["EXTERNAL", "CONTENT", "FILE", "EMAIL_ADDRESS", "PHONE_NUMBER"],
            "default": {
              "url": { "type": "EXTERNAL", "href": "" },
              "open_in_new_tab": false,
              "no_follow": false
            },
            "visibility": {
              "controlling_field": "features.cta.show",
              "controlling_value_regex": "true",
              "operator": "EQUAL"
            }
          },
          {
            "name": "button_style",
            "label": "Button style",
            "type": "choice",
            "display": "select",
            "choices": [["primary", "Primary"], ["secondary", "Secondary / Outline"], ["none", "None (text link)"]],
            "default": "primary",
            "visibility": {
              "controlling_field": "features.cta.show",
              "controlling_value_regex": "true",
              "operator": "EQUAL"
            }
          }
        ]
      }
    ],
    "default": [
      {
        "icon": { "size_type": "exact", "src": "", "alt": "Target icon", "loading": "lazy", "width": 29, "height": 29 },
        "heading_value": "Results Delivered",
        "heading_size": 22,
        "line_height": 0,
        "letter_spacing": 0,
        "font_weight": "medium",
        "column_width": "6",
        "body_copy": "<p>The best activation, measurement, and optimization technology to deliver desired outcomes.</p>",
        "cta": { "show": false, "text": "Learn more", "link": { "url": { "type": "EXTERNAL", "href": "" }, "open_in_new_tab": false, "no_follow": false }, "button_style": "primary" }
      },
      {
        "icon": { "size_type": "exact", "src": "", "alt": "Checkbox icon", "loading": "lazy", "width": 29, "height": 29 },
        "heading_value": "Total control",
        "heading_size": 22,
        "line_height": 0,
        "letter_spacing": 0,
        "font_weight": "medium",
        "column_width": "6",
        "body_copy": "<p>We&rsquo;ll recommend optimal inventory, but you control where to activate, # of days, audiences to leverage, etc.</p>",
        "cta": { "show": false, "text": "Learn more", "link": { "url": { "type": "EXTERNAL", "href": "" }, "open_in_new_tab": false, "no_follow": false }, "button_style": "primary" }
      },
      {
        "icon": { "size_type": "exact", "src": "", "alt": "Bar chart icon", "loading": "lazy", "width": 29, "height": 29 },
        "heading_value": "Radical transparency",
        "heading_size": 22,
        "line_height": 0,
        "letter_spacing": 0,
        "font_weight": "medium",
        "column_width": "6",
        "body_copy": "<p>360&deg; views in real-time into your ad campaign&rsquo;s performance, targeting, attribution, all with dashboards.</p>",
        "cta": { "show": false, "text": "Learn more", "link": { "url": { "type": "EXTERNAL", "href": "" }, "open_in_new_tab": false, "no_follow": false }, "button_style": "primary" }
      },
      {
        "icon": { "size_type": "exact", "src": "", "alt": "Unified UI icon", "loading": "lazy", "width": 29, "height": 29 },
        "heading_value": "Unified UI",
        "heading_size": 22,
        "line_height": 0,
        "letter_spacing": 0,
        "font_weight": "medium",
        "column_width": "6",
        "body_copy": "<p>A user interface that&rsquo;s as simple to use as paid search and social media with familiar controls and levers.</p>",
        "cta": { "show": false, "text": "Learn more", "link": { "url": { "type": "EXTERNAL", "href": "" }, "open_in_new_tab": false, "no_follow": false }, "button_style": "primary" }
      }
    ]
  },

  {
    "name": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "background_color",
        "label": "Section background color",
        "type": "color",
        "default": { "color": "#FFFFFF", "opacity": 100 }
      },
      {
        "name": "background_image",
        "label": "Section background image",
        "type": "image",
        "default": { "size_type": "auto", "src": "", "alt": "", "loading": "lazy" }
      },
      {
        "name": "text_color",
        "label": "Text color",
        "type": "color",
        "default": { "color": null, "opacity": 100 }
      },
      {
        "name": "card_background_color",
        "label": "Inner card background color",
        "type": "color",
        "default": { "color": "#F9FAFC", "opacity": 100 }
      },
      {
        "name": "card_border_color",
        "label": "Inner card border color",
        "type": "color",
        "default": { "color": "#D9E2EB", "opacity": 100 }
      },
      {
        "name": "padding",
        "label": "Section padding",
        "type": "spacing",
        "default": {
          "padding": {
            "top": { "value": 64, "units": "px" },
            "bottom": { "value": 32, "units": "px" }
          }
        }
      }
    ]
  }
]
