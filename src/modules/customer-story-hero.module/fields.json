            "bottom": { "value": 0, "units": "px" }
          }
        }
      },
      {
        "name": "container_max_width",
        "label": "Copy/form container max width",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "default": 1440,
        "inline_help_text": "Max width for the logo/heading/form row. Set 0 for theme default."
      },
      {
        "name": "image_scroll",
        "label": "Auto-scroll hero images",
        "type": "boolean",
        "display": "toggle",
        "default": false,
        "inline_help_text": "Off by default — three static images. Turn on for a full-bleed marquee."
      },
      {
        "name": "image_scroll_direction",
        "label": "Scroll direction",
        "type": "choice",
        "display": "select",
        "choices": [
          ["right", "Left to right"],
          ["left", "Right to left"]
        ],
        "default": "right",
        "visibility": {
          "controlling_field": "style.image_scroll",
          "controlling_value_regex": "true",
          "operator": "EQUAL"
        }
      },
      {
        "name": "image_scroll_duration",
        "label": "Scroll duration",
        "type": "number",
        "suffix": "s",
        "min": 10,
        "max": 240,
        "default": 60,
        "visibility": {
          "controlling_field": "style.image_scroll",
          "controlling_value_regex": "true",
          "operator": "EQUAL"
        }
      }
    ]
