      {
        "name": "value",
        "label": "Heading content",
        "type": "text",
        "allow_new_line": true,
        "default": "Be the next brand to grow big with tvScientific by Pinterest"
      },
      {
        "name": "header_tag",
        "label": "Heading level",
        "type": "choice",
        "required": true,
        "display": "select",
        "choices": [
          ["h1", "H1"], ["h2", "H2"], ["h3", "H3"], ["h4", "H4"], ["h5", "H5"], ["h6", "H6"], ["p", "P"]
        ],
        "default": "h1"
      },
      {
        "name": "heading_size",
        "label": "Heading size",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 72
      },
      {
        "name": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 40
      },
      {
        "name": "font_weight",
        "label": "Font weight",
        "type": "choice",
        "display": "select",
        "choices": [["normal", "Normal"], ["semibold", "Semibold"], ["bold", "Bold"]],
        "default": "semibold"
      }
    ]
  },
  {
    "name": "subheading",
    "label": "Subheading",
    "type": "richtext",
    "default": "<p>Leading enterprise brands trust tvScientific by Pinterest to drive real results and measurable performance.</p>"
  },
  {
