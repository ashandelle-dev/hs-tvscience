[
  {
    "name": "heading",
    "label": "Heading",
    "type": "group",
    "tab": "CONTENT",
    "children": [
      {
        "name": "value",
        "label": "Heading content",
        "type": "text",
        "allow_new_line": true,
        "default": "Most tools create ads.\nWe turn your ads into outcomes."
      },
      {
        "name": "header_tag",
        "label": "Heading level",
        "type": "choice",
        "required": true,
        "display": "select",
        "choices": [
          ["h1", "H1"], ["h2", "H2"], ["h3", "H3"], ["h4", "H4"], ["h5", "H5"], ["h6", "H6"], ["p", "P"]
        ],
        "default": "h2"
      },
      {
        "name": "heading_size",
        "label": "Heading size",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 36
      },
      {
        "name": "heading_size_mobile",
        "label": "Heading size (mobile)",
        "type": "number",
        "suffix": "px",
        "inline_help_text": "Set to 0 to use the default size",
        "default": 28
      },
      {
        "name": "font_weight",
        "label": "Font weight",
        "type": "choice",
        "display": "select",
        "choices": [["normal", "Normal"], ["semibold", "Semibold"], ["bold", "Bold"]],
        "default": "bold"
      }
    ]
  },

  {
    "name": "body_copy",
    "label": "Body",
    "type": "richtext",
    "default": "<p>Interested? Share your email to learn more.</p>"
  },

  {
    "name": "cta_type",
    "label": "Call-to-action type",
    "type": "choice",
    "required": true,
    "display": "radio",
    "choices": [
      ["form", "Inline form"],
      ["button", "Button"]
    ],
    "default": "form",
    "inline_help_text": "Choose between an inline HubSpot form or a linked button."
  },

  {
    "name": "cta",
    "label": "Button",
    "type": "group",
    "tab": "CONTENT",
    "visibility": {
      "controlling_field": "cta_type",
      "controlling_value_regex": "button",
      "operator": "EQUAL"
    },
    "children": [
      {
        "name": "text",
        "label": "Button text",
        "type": "text",
        "allow_new_line": false,
        "default": "Learn more"
      },
      {
        "name": "link",
        "label": "Link",
        "type": "link",
        "supported_types": ["EXTERNAL", "CONTENT", "FILE", "EMAIL_ADDRESS", "BLOG", "CALL_TO_ACTION", "PHONE_NUMBER"],
        "default": {
          "url": { "type": "EXTERNAL", "href": "/contact" },
          "open_in_new_tab": false,
          "no_follow": false
        }
      },
      {
        "name": "button_style",
        "label": "Button style",
        "type": "choice",
        "display": "select",
        "choices": [
          ["primary", "Primary"],
          ["secondary", "Secondary / Outline"]
        ],
        "default": "primary"
      }
    ]
  },

  {
    "name": "form",
    "label": "Form",
    "type": "form",
    "embed_versions": ["v2", "v4"],
    "support_all_webinar_types": true,
    "inline_help_text": "Use a single-field form (e.g. Business Email) plus submit — extra fields will stack below the input.",
    "visibility": {
      "controlling_field": "cta_type",
      "controlling_value_regex": "form",
      "operator": "EQUAL"
    },
    "default": {
      "form_id": "",
      "response_type": "inline",
      "message": "Thanks! We'll be in touch shortly.",
      "gotowebinar_webinar_key": null
    }
  },

  {
    "name": "media",
    "label": "Image",
    "type": "image",
    "tab": "CONTENT",
    "responsive": true,
    "resizable": true,
    "show_loading": true,
    "default": {
      "size_type": "exact",
      "src": "https://tvscientific.com/hubfs/covertion%20rate-1.png",
      "alt": "Woman watching TV with conversion rate trending up",
      "loading": "lazy",
      "width": 546,
      "height": 395
    }
  },

  {
    "name": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "background_color",
        "label": "Section background color",
        "type": "color",
        "default": { "color": "#ffffff", "opacity": 100 }
      },
      {
        "name": "background_image",
        "label": "Section background image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "show_loading": true,
        "default": { "size_type": "exact", "src": "", "alt": "", "loading": "lazy", "width": 1920, "height": 1080 }
      },
      {
        "name": "text_color",
        "label": "Text color",
        "type": "color",
        "default": { "color": null, "opacity": 100 }
      },
      {
        "name": "padding",
        "label": "Section padding",
        "type": "spacing",
        "default": {
          "padding": {
            "top": { "value": 80, "units": "px" },
            "bottom": { "value": 80, "units": "px" }
          }
        }
      },
      {
        "name": "container_max_width",
        "label": "Container max width",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "inline_help_text": "Override the default 1072px container width. Set to 0 to use the theme default.",
        "default": 1200
      },
      {
        "name": "card_background_color",
        "label": "Card background color",
        "type": "color",
        "default": { "color": "#f3fff6", "opacity": 100 }
      },
      {
        "name": "card_border_radius",
        "label": "Card border radius",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "max": 48,
        "default": 20
      },
      {
        "name": "card_content_padding",
        "label": "Card content padding",
        "type": "spacing",
        "default": {
          "padding": {
            "top": { "value": 70, "units": "px" },
            "bottom": { "value": 70, "units": "px" },
            "left": { "value": 70, "units": "px" },
            "right": { "value": 70, "units": "px" }
          }
        }
      }
    ]
  }
]
