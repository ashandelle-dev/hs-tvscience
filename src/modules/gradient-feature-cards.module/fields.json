  {
    "name": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "card_background_color",
        "label": "Card background color (fallback)",
        "type": "color",
        "inline_help_text": "Shows behind the card background image while it loads.",
        "default": { "color": "#f3fff6", "opacity": 100 }
      },
      {
        "name": "card_border_radius",
        "label": "Card border radius",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "max": 48,
        "default": 20
      },
      {
        "name": "card_gap",
        "label": "Gap between cards",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "max": 120,
        "default": 40
      },
      {
        "name": "icon_content_gap",
        "label": "Icon to content gap",
        "type": "number",
        "suffix": "px",
        "min": 0,
        "max": 200,
        "inline_help_text": "Minimum space between the icon and heading block.",
        "default": 110
      },
      {
        "name": "background_color",
        "label": "Section background color",
        "type": "color",
        "default": { "color": "#ffffff", "opacity": 100 }
      },
      {
        "name": "background_image",
        "label": "Section background image",
        "type": "image",
        "responsive": true,
        "resizable": true,
