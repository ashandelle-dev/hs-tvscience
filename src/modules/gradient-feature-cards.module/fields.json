[
  {
    "name": "cards",
    "label": "Cards",
    "type": "group",
    "tab": "CONTENT",
    "occurrence": { "min": 1, "max": 6, "default": 3, "sorting_label_field": "cards.heading.value" },
    "children": [
      {
        "name": "icon",
        "label": "Icon / image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "show_loading": true,
        "default": { "size_type": "exact", "src": "", "alt": "", "loading": "lazy", "width": 60, "height": 60 }
      },
      {
        "name": "heading",
        "label": "Heading",
        "type": "group",
        "children": [
          {
            "name": "value",
            "label": "Heading content",
            "type": "text",
            "allow_new_line": false,
            "default": ""
          },
          {
            "name": "header_tag",
            "label": "Heading level",
            "type": "choice",
            "required": true,
            "display": "select",
            "choices": [
              ["h1", "H1"], ["h2", "H2"], ["h3", "H3"], ["h4", "H4"], ["h5", "H5"], ["h6", "H6"], ["p", "P"]
            ],
            "default": "h3"
          },
          {
            "name": "heading_size",
            "label": "Heading size",
            "type": "number",
            "suffix": "px",
            "inline_help_text": "Set to 0 to use the default size",
            "default": 36
          },
          {
            "name": "heading_size_mobile",
            "label": "Heading size (mobile)",
            "type": "number",
            "suffix": "px",
            "inline_help_text": "Set to 0 to use the default size",
            "default": 28
          },
          {
            "name": "font_weight",
            "label": "Font weight",
            "type": "choice",
            "display": "select",
            "choices": [["normal", "Normal"], ["semibold", "Semibold"], ["bold", "Bold"]],
            "default": "semibold"
          }
        ]
      },
      {
        "name": "body_copy",
        "label": "Description",
        "type": "richtext",
        "default": ""
      },
      {
        "name": "cta",
        "label": "Button",
        "type": "group",
        "children": [
          {
            "name": "show",
            "label": "Show button",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "link",
            "label": "Link",
            "type": "link",
            "supported_types": ["EXTERNAL", "CONTENT", "FILE", "EMAIL_ADDRESS", "BLOG", "CALL_TO_ACTION"],
            "visibility": {
              "controlling_field": "cards.cta.show",
              "controlling_value_regex": "true",
              "operator": "EQUAL"
            },
            "default": {
              "url": { "type": "EXTERNAL", "href": "" },
              "open_in_new_tab": false,
              "no_follow": false
            }
          },
          {
            "name": "text",
            "label": "Button text",
            "type": "text",
            "allow_new_line": false,
            "visibility": {
              "controlling_field": "cards.cta.show",
              "controlling_value_regex": "true",
              "operator": "EQUAL"
            },
            "default": ""
          }
        ]
      },
      {
        "name": "background_image",
        "label": "Card background image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "show_loading": true,
